#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
if docker compose version >/dev/null 2>&1; then
  compose=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  compose=(docker-compose)
else
  echo "Docker Compose is required (docker compose or docker-compose)." >&2
  exit 1
fi
project_name="solid-queue-benchmark-$$"
compose+=(--project-name "$project_name" --file "$root/benchmarks/compose.yml")
results_dir="${RESULTS_DIR:-$root/tmp/benchmarks}"
mkdir -p "$results_dir"
results_dir="$(cd "$results_dir" && pwd)"

cleanup() {
  "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM
cleanup

"${compose[@]}" build benchmark
"${compose[@]}" up --detach --wait --wait-timeout 90 postgres mongodb

"${compose[@]}" run --rm --no-deps --no-TTY \
  --env DATABASE_URL=postgresql://postgres@postgres/solid_queue_benchmark \
  --env 'MONGODB_URI=mongodb://mongodb:27017/solid_queue_benchmark?replicaSet=rs0' \
  benchmark bundle exec ruby benchmarks/environment.rb > "$results_dir/environment.json"
printf '%s\n' "Benchmark environment:"
cat "$results_dir/environment.json"
printf '\n'

workload=(
  --env "JOBS=${JOBS:-2000}"
  --env "WORKERS=${WORKERS:-8}"
  --env "REPETITIONS=${REPETITIONS:-3}"
  --env "PAYLOAD_BYTES=${PAYLOAD_BYTES:-256}"
)

"${compose[@]}" run --rm --no-deps --no-TTY \
  "${workload[@]}" \
  --env BACKEND=active_record \
  --env DATABASE_URL=postgresql://postgres@postgres/solid_queue_benchmark \
  benchmark > "$results_dir/postgres.json"

"${compose[@]}" run --rm --no-deps --no-TTY \
  "${workload[@]}" \
  --env BACKEND=mongodb \
  --env 'MONGODB_URI=mongodb://mongodb:27017/solid_queue_benchmark?replicaSet=rs0' \
  benchmark > "$results_dir/mongodb.json"

printf '%s\n' "Strict comparison:"
"${compose[@]}" run --rm --no-deps --no-TTY \
  --volume "$results_dir:/results:ro" \
  benchmark bundle exec ruby benchmarks/compare.rb \
  /results/postgres.json /results/mongodb.json |
  tee "$results_dir/comparison.json"
