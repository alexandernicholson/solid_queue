source "https://rubygems.org"

gem "mongo", ENV.fetch("MONGO_DRIVER_VERSION", ">= 2.24"), "< 3"
gem "railties", ENV.fetch("RAILS_VERSION", "~> 8.1.0")
gem "json", "< 3"
gem "propshaft"
gem "mission_control-jobs", path: ENV.fetch("MISSION_CONTROL_JOBS_PATH", File.expand_path("../../mission_control-jobs", __dir__))

gemspec path: "../"
