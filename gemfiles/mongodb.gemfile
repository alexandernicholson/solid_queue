source "https://rubygems.org"

setting = ->(name, default) { ENV[name].to_s.empty? ? default : ENV[name] }

gem "mongo", setting.("MONGO_DRIVER_VERSION", "2.26.0")
gem "railties", setting.("RAILS_VERSION", "8.1.3.1")
gem "json", "< 3"
gem "ostruct"

mongoid_source = { git: setting.("MONGOID_GIT", nil), ref: setting.("MONGOID_REF", nil) }.compact
gem "mongoid", setting.("MONGOID_VERSION", "9.1.1"), **mongoid_source, require: false

gemspec path: "../"
